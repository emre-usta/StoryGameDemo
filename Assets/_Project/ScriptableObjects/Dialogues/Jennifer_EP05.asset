  m_Script: {fileID: 11500000, guid: 2bff8340c4a2e124b8caff9676c036e8, type: 3}
  m_Name: Jennifer_EP05
  m_EditorClassIdentifier: 
  episodeId: jennifer_ep05
  characterId: jennifer
  episodeIndex: 4
  nodes:
  - id: node_001
    type: 0
    speaker: 
    text: "Yedi yirmi be\u015F. Kasaban\u0131n tek bal\u0131k\xE7\u0131s\u0131 dar
      bir soka\u011F\u0131n sonunda \u2014 tabelas\u0131 yok, sadece bal\u0131k kokusu
      ve \u0131\u015F\u0131k. Bunu bilmeseydin bulamazd\u0131n."
    backgroundId: 
    nextNodeId: node_002
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_002
    type: 0
    speaker: 
    text: "\u0130\xE7eri giriyorsun. Dolu \u2014 ama bir masa bo\u015F. K\xF6\u015Fede.
      Ve Jenniffer orada, s\u0131rt\u0131 duvara dayal\u0131, kap\u0131ya bak\u0131yor.
      Seni daha i\xE7eri girmeden g\xF6rd\xFC."
    backgroundId: 
    nextNodeId: node_003
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_003
    type: 0
    speaker: Jenniffer
    text: "Ge\xE7 kalmad\u0131n."
    backgroundId: 
    nextNodeId: node_004
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_004
    type: 0
    speaker: 
    text: "S\xF6yl\xFCyor. Ne iyi ne k\xF6t\xFC. Bir tespit."
    backgroundId: 
    nextNodeId: node_005
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_005
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Ge\xE7 kalmamaya \xE7al\u0131\u015Ft\u0131m."
      nextNodeId: node_006
      effect:
        affection: 3
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Notu ald\u0131\u011F\u0131nda neden \u015Fa\u015F\u0131rd\u0131n ki?"
      nextNodeId: node_007
      effect:
        affection: 2
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "B\u0131rakmasan da gelirdim zaten."
      nextNodeId: node_008
      effect:
        affection: 10
        setFlag: 
      isDiamond: 1
      diamondCost: 5
    requiredFlag: 
    altNodeId: 
  - id: node_006
    type: 1
    speaker: Jennifer
    text: "G\xF6r\xFCyorum."
    backgroundId: 
    nextNodeId: node_009
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_007
    type: 1
    speaker: Jennifer
    text: "\u015Ea\u015F\u0131rmad\u0131m."
    backgroundId: 
    nextNodeId: node_009
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_008
    type: 0
    speaker: Jennifer
    text: Bunu nereden biliyorsun?
    backgroundId: 
    nextNodeId: node_008b
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_008b
    type: 0
    speaker: 
    text: "Cevap vermiyorsun. Oturuyorsun. Jenniffer g\xF6zlerini k\u0131s\u0131yor
      \u2014 ama bir \u015Fey var orada. Tam olarak ne oldu\u011Funu hen\xFCz \xE7\xF6zemedin."
    backgroundId: 
    nextNodeId: node_009
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_009
    type: 0
    speaker: 
    text: "Oturuyorsun. Garson geliyor, men\xFC yok \u2014 bug\xFCn\xFCn bal\u0131\u011F\u0131
      ne varsa o. Jenniffer garsonla iki kelime konu\u015Fuyor, garson ba\u015F\u0131n\u0131
      sallay\u0131p gidiyor."
    backgroundId: 
    nextNodeId: node_010
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_010
    type: 1
    speaker: Jennifer
    text: "Bal\u0131k yiyor musun?"
    backgroundId: 
    nextNodeId: node_011
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_011
    type: 0
    speaker: 
    text: "Sormadan sipari\u015F verdi. \u015Eimdi soruyor."
    backgroundId: 
    nextNodeId: node_012
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_012
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: Yiyorum.
      nextNodeId: node_013
      effect:
        affection: 2
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Sipari\u015F verdin zaten."
      nextNodeId: node_014
      effect:
        affection: 4
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Seninle ayn\u0131 \u015Feyi yiyebilirim."
      nextNodeId: node_015
      effect:
        affection: 8
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    requiredFlag: 
    altNodeId: 
  - id: node_013
    type: 1
    speaker: Jenniffer
    text: "\u0130yi."
    backgroundId: 
    nextNodeId: node_016
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_014
    type: 1
    speaker: Jennifer
    text: "Evet. \u015Eimdi sorduk."
    backgroundId: 
    nextNodeId: node_016
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_015
    type: 1
    speaker: Jennifer
    text: O zaten en iyisi.
    backgroundId: 
    nextNodeId: node_016
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_016
    type: 0
    speaker: 
    text: "Yemekler geliyor. \u0130kisi de yiyor. Restoran\u0131n g\xFCr\xFClt\xFCs\xFC
      var ama masada sessizlik. Bu sefer farkl\u0131 bir sessizlik \u2014 d\xFCn
      rahat hissettiriyordu, bu gece gergin."
    backgroundId: 
    nextNodeId: node_017
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_017
    type: 0
    speaker: 
    text: "Jenniffer \xE7atal\u0131n\u0131 b\u0131rak\u0131yor. Masaya koyuyor, d\xFCzg\xFCnce.
      Sana bak\u0131yor."
    backgroundId: 
    nextNodeId: node_018
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_018
    type: 1
    speaker: Jennifer
    text: "D\xFCn gece ne d\xFC\u015F\xFCnd\xFCn? Nottan sonra."
    backgroundId: 
    nextNodeId: node_019
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_019
    type: 0
    speaker: 
    text: "Do\u011Frudan soruyor. Jenniffer'den bekledi\u011Fin t\xFCrden de\u011Fil
      bu \u2014 ya da beklemeni istiyor olabilir."
    backgroundId: 
    nextNodeId: node_020
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_020
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Ger\xE7ekten gelmeli miyim diye d\xFC\u015F\xFCnd\xFCm."
      nextNodeId: node_021
      effect:
        affection: 4
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Hi\xE7 d\xFC\u015F\xFCnmedim. Geldim."
      nextNodeId: node_022
      effect:
        affection: 6
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Seni d\xFC\u015F\xFCnd\xFCm. Ba\u015Fka bir \u015Fey de\u011Fil."
      nextNodeId: node_023
      effect:
        affection: 12
        setFlag: trustEstablished
      isDiamond: 1
      diamondCost: 7
    requiredFlag: 
    altNodeId: 
  - id: node_021
    type: 1
    speaker: Jennifer
    text: Ve?
    backgroundId: 
    nextNodeId: node_021b
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_021b
    type: 0
    speaker: 
    text: "Bekliyor. Ger\xE7ek cevab\u0131 bekliyor."
    backgroundId: 
    nextNodeId: node_024
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_022
    type: 1
    speaker: Jennifer
    text: "D\xFC\u015F\xFCnmeden hareket ediyorsun demek."
    backgroundId: 
    nextNodeId: node_024
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_023
    type: 0
    speaker: Jenniffer
    text: ...
    backgroundId: 
    nextNodeId: 
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_023b
    type: 0
    speaker: 
    text: "Sesi yok. G\xF6zleri var. Bir \u015Fey ge\xE7iyor onlardan \u2014 h\u0131zl\u0131,
      kontroll\xFC. Ama ge\xE7iyor."
    backgroundId: 
    nextNodeId: node_024
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_024
    type: 1
    speaker: Jennifer
    text: "Ben de d\xFC\u015F\xFCnd\xFCm. Neden not b\u0131rakt\u0131\u011F\u0131m\u0131."
    backgroundId: 
    nextNodeId: node_025
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_025
    type: 0
    speaker: 
    text: "\xC7atal\u0131n\u0131 tekrar al\u0131yor. Yemeye devam ediyor. Sanki hi\xE7
      s\xF6ylemedi."
    backgroundId: 
    nextNodeId: node_026
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_026
    type: 0
    speaker: 
    text: "Yemek bitmek \xFCzere. \u015Earap geliyor \u2014 istemeden, ama Jenniffer'in
      bu restoranla anla\u015Fmas\u0131 var gibi. Her \u015Fey otomatik."
    backgroundId: 
    nextNodeId: node_027
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_027
    type: 0
    speaker: 
    text: "Jenniffer'in telefonu titre\u015Fiyor. Masan\u0131n \xFCst\xFCnde, y\xFCz\xFC
      a\u015Fa\u011F\u0131. \xDC\xE7 kez. O bakm\u0131yor."
    backgroundId: 
    nextNodeId: node_028
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_028
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Telefonun \xE7al\u0131yor."
      nextNodeId: node_029
      effect:
        affection: 2
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Bakmak zorunda de\u011Filsin."
      nextNodeId: node_030
      effect:
        affection: 5
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Kim oldu\u011Funu merak etmiyorum. Ama sen merak ediyorsun."
      nextNodeId: node_031
      effect:
        affection: 11
        setFlag: 
      isDiamond: 1
      diamondCost: 8
    requiredFlag: 
    altNodeId: 
  - id: node_029
    type: 1
    speaker: Jennifer
    text: Biliyorum.
    backgroundId: 
    nextNodeId: node_032
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_030
    type: 1
    speaker: Jennifer
    text: "Zaten bakm\u0131yorum."
    backgroundId: 
    nextNodeId: node_032
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_031
    type: 1
    speaker: Jennifer
    text: Merak etmiyorum.
    backgroundId: 
    nextNodeId: 
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_031b
    type: 0
    speaker: 
    text: "Ama yutkunuyor. K\xFC\xE7\xFCk, h\u0131zl\u0131 bir hareket. Fark ediyorsun."
    backgroundId: 
    nextNodeId: node_032
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_032
    type: 0
    speaker: 
    text: "Telefon duruyor. Jenniffer \u015Farab\u0131ndan bir yudum i\xE7iyor. Elleri
      masada, sakin. Ama \xE7ok sakin."
    backgroundId: 
    nextNodeId: node_033
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_033
    type: 1
    speaker: Jennifer
    text: "Bu kasabada ne kadar kalacaks\u0131n?"
    backgroundId: 
    nextNodeId: node_034
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_034
    type: 0
    speaker: 
    text: "Konu de\u011Fi\u015Fti. Ya da de\u011Fi\u015Fmedi \u2014 belki bu hep
      ayn\u0131 konuydu."
    backgroundId: 
    nextNodeId: node_035
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_035
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Bir hafta planlad\u0131m."
      nextNodeId: node_036
      effect:
        affection: 3
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: Bilmiyorum. Belki daha uzun.
      nextNodeId: node_037
      effect:
        affection: 5
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Sen burada oldu\u011Fun s\xFCrece."
      nextNodeId: node_038
      effect:
        affection: 13
        setFlag: recklessPath
      isDiamond: 1
      diamondCost: 9
    requiredFlag: 
    altNodeId: 
  - id: node_036
    type: 1
    speaker: Jennifer
    text: Bir hafta uzun.
    backgroundId: 
    nextNodeId: node_039
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_037
    type: 1
    speaker: Jennifer
    text: Neden daha uzun?
    backgroundId: 
    nextNodeId: node_039
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_038
    type: 1
    speaker: Jennifer
    text: "Bu \xE7ok aptalca bir \u015Fey."
    backgroundId: 
    nextNodeId: 
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_038b
    type: 0
    speaker: 
    text: "Aptalca diyor. Ama masada durdu\u011Fu yer biraz de\u011Fi\u015Fiyor \u2014
      fark\u0131nda m\u0131 de\u011Fil mi bilemiyorsun. Sana do\u011Fru, \xE7ok az,
      ama belirgin."
    backgroundId: 
    nextNodeId: node_039
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_039
    type: 0
    speaker: 
    text: "Restoran seyrekle\u015Fiyor. I\u015F\u0131klar k\u0131s\u0131lmaya ba\u015Fl\u0131yor.
      Garson hesab\u0131 getiriyor \u2014 Jenniffer bu sefer sormadan ikisini birden
      \xF6d\xFCyor."
    backgroundId: 
    nextNodeId: node_040
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_040
    type: 0
    speaker: 
    text: ...
    backgroundId: 
    nextNodeId: node_042
    choices: []
    requiredFlag: smoothTalker
    altNodeId: node_041
  - id: node_041
    type: 0
    speaker: 
    text: "D\u0131\u015Far\u0131 \xE7\u0131k\u0131yorsunuz. Sokak \u0131ss\u0131z,
      hava serinlemi\u015F. Jenniffer cebine ellerini koyuyor."
    backgroundId: 
    nextNodeId: node_043
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_042
    type: 0
    speaker: 
    text: "D\u0131\u015Far\u0131 \xE7\u0131k\u0131yorsunuz. Jenniffer bir an duruyor,
      sana bak\u0131yor \u2014 d\xFCn gece kafedeki an geliyor akl\u0131na. O an
      da b\xF6yle durmu\u015Ftu. Sanki bir \u015Fey s\xF6ylemek \xFCzere."
    backgroundId: 
    nextNodeId: node_043
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_043
    type: 0
    speaker: Jennifer
    text: "Y\xFCr\xFCyelim."
    backgroundId: 
    nextNodeId: node_044
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_044
    type: 0
    speaker: 
    text: "Nereye diye sormuyorsun. Y\xFCr\xFCyorsun. Ve yine \u2014 davet yok, ret
      yok. Sadece iki insan ayn\u0131 y\xF6ne gidiyor."
    backgroundId: 
    nextNodeId: node_045
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_045
    type: 0
    speaker: 
    text: "Sahile iniyorsunuz. Gece sahili ba\u015Fka \u2014 \u0131\u015F\u0131klar
      az, ses az, deniz karanl\u0131k. Dalgalar\u0131n sesi her \u015Feyin \xFCst\xFCne
      \xF6rt\xFCyor."
    backgroundId: 
    nextNodeId: node_046
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_046
    type: 0
    speaker: 
    text: "Jenniffer ayakkab\u0131lar\u0131n\u0131 \xE7\u0131kar\u0131yor. Islak
      kuma bas\u0131yor. Y\xFCr\xFCyor, konu\u015Fmuyor."
    backgroundId: 
    nextNodeId: node_047
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_047
    type: 0
    speaker: 
    text: ...
    backgroundId: 
    nextNodeId: node_049
    choices: []
    requiredFlag: sharedSilence
    altNodeId: node_048
  - id: node_048
    type: 0
    speaker: 
    text: "Sen de \xE7\u0131kar\u0131yorsun. Yan yana y\xFCr\xFCyorsunuz, aran\u0131zda
      bir kar\u0131\u015F mesafe. Hi\xE7 konu\u015Fmadan."
    backgroundId: 
    nextNodeId: node_050
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_049
    type: 0
    speaker: 
    text: "Sen de \xE7\u0131kar\u0131yorsun \u2014 d\xFCn kayay\u0131 payla\u015Ft\u0131\u011F\u0131n
      gibi, sormadan. Jenniffer seni bir kez yan g\xF6zle s\xFCz\xFCyor. Hafif\xE7e.
      Sonra y\xFCr\xFCmeye devam ediyor. Aran\u0131zda bir kar\u0131\u015F mesafe.
      Hi\xE7 konu\u015Fmadan."
    backgroundId: 
    nextNodeId: node_050
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_050
    type: 0
    speaker: Jennifer
    text: Bu kasabaya neden geldim biliyor musun?
    backgroundId: 
    nextNodeId: node_051
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_051
    type: 0
    speaker: 
    text: "Duruyor. Y\xFCr\xFCmeyi kesiyor, denize bak\u0131yor."
    backgroundId: 
    nextNodeId: node_052
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_052
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: Bilmiyorum. Anlat.
      nextNodeId: node_053
      effect:
        affection: 3
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Tatil de\u011Fil diye s\xF6yledin. O kadar biliyorum."
      nextNodeId: node_054
      effect:
        affection: 5
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Anlatmak zorunda de\u011Filsin. Ama buraday\u0131m."
      nextNodeId: node_055
      effect:
        affection: 12
        setFlag: trustEstablished
      isDiamond: 1
      diamondCost: 10
    requiredFlag: 
    altNodeId: 
  - id: node_053
    type: 1
    speaker: Jennifer
    text: "Anlat. \u0130lgin\xE7."
    backgroundId: 
    nextNodeId: node_056
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_054
    type: 1
    speaker: Jennifer
    text: Dikkat ediyorsun.
    backgroundId: 
    nextNodeId: 
    choices: []
    requiredFlag: 
    altNodeId: node_056
  - id: node_055
    type: 1
    speaker: Jennifer
    text: "Neden hep bunu s\xF6yl\xFCyorsun?"
    backgroundId: 
    nextNodeId: node_055b
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_055b
    type: 0
    speaker: 
    text: "Sormadan \xF6nce cevab\u0131 biliyor gibi soruyor. K\u0131zg\u0131n de\u011Fil
      \u2014 kafas\u0131 kar\u0131\u015F\u0131k."
    backgroundId: 
    nextNodeId: node_056
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_056
    type: 0
    speaker: Jennifer
    text: "Bir \u015Feyden ka\xE7\u0131yorum. Ama buras\u0131 da art\u0131k yeterli
      de\u011Fil."
    backgroundId: 
    nextNodeId: node_057
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_057
    type: 0
    speaker: 
    text: "S\xF6yl\xFCyor. Sade. A\xE7\u0131klam\u0131yor \u2014 ne oldu\u011Funu
      s\xF6ylemiyor, ne kadar s\xFCrd\xFC\u011F\xFCn\xFC s\xF6ylemiyor. Sadece bu
      c\xFCmleyi koyuyor ortaya."
    backgroundId: 
    nextNodeId: node_058
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_058
    type: 0
    speaker: 
    text: ...
    backgroundId: 
    nextNodeId: node_060
    choices: []
    requiredFlag: deepConnection
    altNodeId: node_059
  - id: node_059
    type: 0
    speaker: 
    text: "Denize bak\u0131yorsunuz. Sessizlik."
    backgroundId: 
    nextNodeId: node_061
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_060
    type: 0
    speaker: 
    text: "D\xFCn bal\u0131k\xE7\u0131ya git dedi\u011Finde \u2014 bu y\xFCzden dedi,
      hissediyorsun. Buradan ayr\u0131lmadan \xF6nce birileriyle konu\u015Fmak istedi.
      Seninle."
