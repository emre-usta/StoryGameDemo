  episodeId: jennifer_ep04
  characterId: jennifer
  episodeIndex: 3
  nodes:
  - id: node_001
    type: 0
    speaker: 
    text: "K\xFC\xE7\xFCk bir sahil kasabas\u0131. Ad\u0131n\u0131 daha \xF6nce duymad\u0131n
      \u2014 zaten \xF6yle bir yer bu. Kimsenin akl\u0131nda kalm\u0131yor, ama bir
      kez gelince bir daha gitmek istemiyorsun. Ya da \xF6yle s\xF6yl\xFCyorlar."
    backgroundId: 
    nextNodeId: node_002
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_002
    type: 0
    speaker: 
    text: "Saat sabah\u0131n onu. Bavulun a\u011F\u0131r, g\xFCne\u015F ac\u0131mas\u0131z.
      Otel hen\xFCz oda vermiyor \u2014 erken geldin. \xC7antan\u0131 resepsiyona
      b\u0131rak\u0131p sahile iniyorsun."
    backgroundId: 
    nextNodeId: node_003
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_003
    type: 0
    speaker: 
    text: "Sahil \u015Feridindeki k\xFC\xE7\xFCk kafe dolu. Tek bo\u015F sandalye
      yok \u2014 tek bo\u015F yer yok. Tek bir istisna d\u0131\u015F\u0131nda: K\xF6\u015Fedeki
      masa. \u0130ki ki\u015Filik. Ve masan\u0131n yar\u0131s\u0131 bo\u015F."
    backgroundId: 
    nextNodeId: node_004
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_004
    type: 0
    speaker: 
    text: "Masada oturan kad\u0131n pencereye bak\u0131yor. Yan\u0131ndaki sandalyede
      \xE7antas\u0131 var \u2014 ama \xE7anta bir yer tutmaz, insan tutar. Garson
      omuz silkiyor. 'Ba\u015Fka yer yok.' diyor."
    backgroundId: 
    nextNodeId: 
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_005
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: node_006
    choices:
    - text: "Affedersiniz, buras\u0131 bo\u015F mu?"
      nextNodeId: node_006
      effect:
        affection: 3
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "\xC7antan\u0131 masadan alabilir misin?"
      nextNodeId: node_007
      effect:
        affection: 0
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "G\xF6r\xFCn\xFC\u015Fe g\xF6re bug\xFCn \u015Fans\u0131m varm\u0131\u015F."
      nextNodeId: node_007b
      effect:
        affection: 8
        setFlag: smoothTalker
      isDiamond: 1
      diamondCost: 5
    requiredFlag: 
    altNodeId: 
  - id: node_006
    type: 1
    speaker: Jenniffer
    text: "Bo\u015F g\xF6r\xFCnm\xFCyor zaten."
    backgroundId: 
    nextNodeId: node_008
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_007
    type: 1
    speaker: Jenniffer
    text: ...
    backgroundId: 
    nextNodeId: node_008
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_007b
    type: 0
    speaker: Jenniffer
    text: "\u015Eans\u0131n m\u0131. \u0130lgin\xE7 bir yorum."
    backgroundId: 
    nextNodeId: node_008
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_008
    type: 0
    speaker: 
    text: "Cevap ne olursa olsun \xE7antay\u0131 al\u0131p sandalyeye koyuyor. Sana
      de\u011Fil, garsonad\u0131r bu. Belki."
    backgroundId: 
    nextNodeId: node_009
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_009
    type: 0
    speaker: 
    text: "Oturuyorsun. Kad\u0131n sana bir daha bakm\u0131yor. Denize bak\u0131yor
      \u2014 ama denizi g\xF6rm\xFCyor gibi. G\xF6zleri bir noktada sabit, akl\u0131
      ba\u015Fka yerde."
    backgroundId: 
    nextNodeId: node_010
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_010
    type: 0
    speaker: Jenniffer
    text: "Men\xFCy\xFC uzun s\xFCre tutma. Sipari\u015Fini ver, b\u0131rak."
    backgroundId: 
    nextNodeId: node_011
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_011
    type: 0
    speaker: 
    text: "Men\xFCy\xFC sana f\u0131rlat\u0131rcas\u0131na uzat\u0131yor. G\xF6zleri
      h\xE2l\xE2 d\u0131\u015Far\u0131da."
    backgroundId: 
    nextNodeId: node_012
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_012
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Te\u015Fekk\xFCrler."
      nextNodeId: node_013
      effect:
        affection: 2
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Sen zaten sipari\u015F verdin mi?"
      nextNodeId: node_014
      effect:
        affection: 4
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Buran\u0131n \xF6nerdi\u011Fin bir \u015Feyi var m\u0131?"
      nextNodeId: node_014b
      effect:
        affection: 7
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    requiredFlag: 
    altNodeId: 
  - id: node_013
    type: 1
    speaker: Jenniffer
    text: Rica ederim.
    backgroundId: 
    nextNodeId: node_015
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_014
    type: 1
    speaker: Jennifer
    text: "Verdim. Seninle konu\u015Fmak i\xE7in vermedim."
    backgroundId: 
    nextNodeId: node_015
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_014b
    type: 1
    speaker: Jennifer
    text: "Limon tart. Ama muhtemelen tatl\u0131 yemezsin."
    backgroundId: 
    nextNodeId: node_015
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_015
    type: 0
    speaker: 
    text: "Garson geliyor. Sipari\u015Fini veriyorsun. Kad\u0131n h\xE2l\xE2 d\u0131\u015Far\u0131
      bak\u0131yor \u2014 ama bu sefer sesi biraz farkl\u0131yd\u0131. Limon tart.
      Seni \xF6l\xE7t\xFC."
    backgroundId: 
    nextNodeId: node_016
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_016
    type: 0
    speaker: 
    text: "On dakika ge\xE7iyor. Sipari\u015Fler geliyor. \u0130kisi de yiyor, kimse
      konu\u015Fmuyor. Ama bu sessizlik gergin de\u011Fil \u2014 garip bir \u015Fekilde,
      rahat."
    backgroundId: 
    nextNodeId: node_017
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_017
    type: 0
    speaker: Jenniffer
    text: Tatil mi burada?
    backgroundId: 
    nextNodeId: node_018
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_018
    type: 0
    speaker: 
    text: "\u0130lk o soruyor. Seni umursam\u0131yor gibi yap\u0131yor \u2014 ama
      sordu."
    backgroundId: 
    nextNodeId: node_019
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_019
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Evet. Biraz dinlenmek i\xE7in."
      nextNodeId: node_020
      effect:
        affection: 2
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Ka\xE7mak i\xE7in, desek daha do\u011Fru."
      nextNodeId: node_021
      effect:
        affection: 5
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Hen\xFCz bilmiyorum. \u0130lk kez geldim."
      nextNodeId: node_022
      effect:
        affection: 4
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    requiredFlag: 
    altNodeId: 
  - id: node_020
    type: 1
    speaker: Jennifer
    text: "Herkes \xF6yle diyor."
    backgroundId: 
    nextNodeId: node_023
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_021
    type: 1
    speaker: Jennifer
    text: ...
    backgroundId: 
    nextNodeId: node_022b
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_022b
    type: 0
    speaker: 
    text: "Sana bakmaya ba\u015Fl\u0131yor. \u0130lk kez \u2014 ger\xE7ekten bak\u0131yor."
    backgroundId: 
    nextNodeId: node_023
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_022
    type: 1
    speaker: Jennifer
    text: "En az\u0131ndan d\xFCr\xFCsts\xFCn."
    backgroundId: 
    nextNodeId: node_023
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_023
    type: 1
    speaker: Jennifer
    text: "Bu kasabada bir hafta sonra s\u0131k\u0131l\u0131rs\u0131n. Herkes s\u0131k\u0131l\u0131yor."
    backgroundId: 
    nextNodeId: 'node_024 '
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_024
    type: 0
    speaker: 
    text: "Bunu s\xF6ylerken sesi d\xFCz. Yarg\u0131lam\u0131yor \u2014 bir olguyu
      aktar\u0131yor."
    backgroundId: 
    nextNodeId: node_025
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_025
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Sen s\u0131k\u0131lmad\u0131n m\u0131?"
      nextNodeId: node_026
      effect:
        affection: 5
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Belki ben farkl\u0131y\u0131m."
      nextNodeId: node_027
      effect:
        affection: 3
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Sen ka\xE7 g\xFCnd\xFCr buradas\u0131n?"
      nextNodeId: node_028
      effect:
        affection: 9
        setFlag: firstCrack
      isDiamond: 1
      diamondCost: 6
    requiredFlag: 
    altNodeId: 
  - id: node_026
    type: 1
    speaker: Jennifer
    text: "Ben burada tatilde de\u011Filim."
    backgroundId: 
    nextNodeId: node_029
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_027
    type: 1
    speaker: Jennifer
    text: "Herkes \xF6yle d\xFC\u015F\xFCn\xFCr."
    backgroundId: 
    nextNodeId: node_029
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_028
    type: 1
    speaker: Jennifer
    text: "On iki g\xFCn."
    backgroundId: 
    nextNodeId: node_028b
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_028b
    type: 0
    speaker: 
    text: "Duraks\u0131yor. Sanki bu say\u0131y\u0131 ilk kez kendisi de duyuyor
      gibi."
    backgroundId: 
    nextNodeId: node_029
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_029
    type: 0
    speaker: 
    text: "Kahvesi geliyor. Kar\u0131\u015Ft\u0131r\u0131yor ama i\xE7miyor. Masaya
      bak\u0131yor."
    backgroundId: 
    nextNodeId: node_030
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_030
    type: 1
    speaker: Jennifer
    text: "Ad\u0131n ne?"
    backgroundId: 
    nextNodeId: node_031
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_031
    type: 0
    speaker: 
    text: "Soruyor. H\xE2l\xE2 masaya bakarak soruyor. Ama soruyor."
    backgroundId: 
    nextNodeId: node_032
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_032
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: '{playerName}'
      nextNodeId: node_033
      effect:
        affection: 3
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "\xD6nce sen s\xF6yle."
      nextNodeId: node_034
      effect:
        affection: 2
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: Neden merak ettin?
      nextNodeId: node_035
      effect:
        affection: 6
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    requiredFlag: 
    altNodeId: 
  - id: node_033
    type: 1
    speaker: Jennifer
    text: Jenniffer.
    backgroundId: 
    nextNodeId: node_036
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_034
    type: 1
    speaker: Jennifer
    text: Ben sorduk. Jenniffer.
    backgroundId: 
    nextNodeId: node_036
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_035
    type: 1
    speaker: Jennifer
    text: Merak etmedim. Sordum.
    backgroundId: 
    nextNodeId: node_035b
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_035b
    type: 0
    speaker: 
    text: "Fark var m\u0131 ikisi aras\u0131nda? Sormak \xFCzeresin ama b\u0131rak\u0131yorsun.
      Jenniffer diyor. K\u0131saca."
    backgroundId: 
    nextNodeId: node_036
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_036
    type: 0
    speaker: 
    text: "Saat \xF6\u011Fleni ge\xE7iyor. Kafe dolup ta\u015F\u0131yor, \u0131s\u0131
      art\u0131yor. Jenniffer hesab\u0131n\u0131 \xF6d\xFCyor \u2014 garip bir \u015Fekilde
      ikisini birden."
    backgroundId: 
    nextNodeId: node_037
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_037
    type: 1
    speaker: Jennifer
    text: "Masam\u0131 i\u015Fgal etti\u011Fin i\xE7in. E\u015Fit olsun."
    backgroundId: 
    nextNodeId: node_038
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_038
    type: 0
    speaker: 
    text: "Kalk\u0131yor. Sen de kalk\u0131yorsun. \u0130kisi de ayn\u0131 y\xF6ne
      gidiyor \u2014 sahil."
    backgroundId: 
    nextNodeId: node_039
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_039
    type: 0
    speaker: 
    text: "Yan yana y\xFCr\xFCyorsunuz. Kimse davet etmedi, kimse reddetmedi. Dalgalar\u0131n
      sesi var, r\xFCzgar var \u2014 ve garip bir rahatl\u0131k."
    backgroundId: 
    nextNodeId: node_040
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_040
    type: 1
    speaker: Jennifer
    text: "Tatilini planlad\u0131n m\u0131 yoksa ka\xE7t\u0131n m\u0131 ger\xE7ekten?"
    backgroundId: 
    nextNodeId: node_041
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_041
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Planlad\u0131m. Ama plan benim i\xE7in de\u011Fildi sanki."
      nextNodeId: node_042
      effect:
        affection: 5
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Ka\xE7t\u0131m. Ve bir nedenim oldu\u011Funu s\xF6ylemeyece\u011Fim."
      nextNodeId: node_043
      effect:
        affection: 4
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "\u0130kisi aras\u0131nda fark var m\u0131 ki?"
      nextNodeId: node_044
      effect:
        affection: 11
        setFlag: firstCrack
      isDiamond: 1
      diamondCost: 7
    requiredFlag: 
    altNodeId: 
  - id: node_042
    type: 1
    speaker: Jennifer
    text: "Anlad\u0131m."
    backgroundId: 
    nextNodeId: node_045
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_043
    type: 0
    speaker: Jennifer
    text: "S\xF6ylemek zorunda de\u011Filsin zaten."
    backgroundId: 
    nextNodeId: node_045
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_044
    type: 0
    speaker: Jenniffer
    text: ...
    backgroundId: 
    nextNodeId: 
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_044b
    type: 0
    speaker: 
    text: "Duruyor. Denize bak\u0131yor. Uzun bir sessizlik. Sonra y\xFCr\xFCmeye
      devam ediyor."
    backgroundId: 
    nextNodeId: node_044c
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_044c
    type: 1
    speaker: Jennifer
    text: Var. Ama bazen yok.
    backgroundId: 
    nextNodeId: node_045
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_045
    type: 0
    speaker: 
    text: "Sahilin ucuna geliyorsunuz. B\xFCy\xFCk bir kaya var \u2014 insanlar oturmu\u015F,
      ayaklar\u0131 suyun i\xE7inde. Jenniffer kayaya \xE7\u0131k\u0131yor. Seni
      davet etmiyor."
    backgroundId: 
    nextNodeId: node_046
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_046
    type: 0
    speaker: 
    text: "Ama yer var yan\u0131nda."
    backgroundId: 
    nextNodeId: node_047
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_047
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Yan\u0131na \xE7\u0131k\u0131yorsun."
      nextNodeId: node_048
      effect:
        affection: 4
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "A\u015Fa\u011F\u0131da kal\u0131yorsun, ayaklar\u0131n\u0131 suya sark\u0131t\u0131yorsun."
      nextNodeId: node_049
      effect:
        affection: 2
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Yan\u0131na \xE7\u0131k\u0131yorsun. Hi\xE7 sormadan."
      nextNodeId: node_050
      effect:
        affection: 12
        setFlag: sharedSilence
      isDiamond: 1
      diamondCost: 8
    requiredFlag: 
    altNodeId: 
  - id: node_048
    type: 1
    speaker: Jennifer
    text: "\u0130zin almad\u0131n."
    backgroundId: 
    nextNodeId: node_051
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_049
    type: 1
    speaker: Jennifer
    text: "Daha ak\u0131ll\u0131."
    backgroundId: 
    nextNodeId: node_051
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_050
    type: 0
    speaker: 
    text: "Jenniffer'e bakm\u0131yorsun bile. Sadece \xE7\u0131k\u0131yorsun. Oturuyorsun.
      Denize bak\u0131yorsun. O da bir \u015Fey s\xF6ylemiyor."
    backgroundId: 
    nextNodeId: node_050b
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_050b
    type: 1
    speaker: Jenniffer
    text: ...
    backgroundId: 
    nextNodeId: node_050c
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_050c
    type: 0
    speaker: 
    text: "Bir s\xFCre sonra \u2014 \xE7ok k\u0131sa, neredeyse fark edemeyece\u011Fin
      kadar \u2014 hafif\xE7e g\xFCl\xFCms\xFCyor. Ama bunu g\xF6rm\xFCyorsun. Ya
      da g\xF6rm\xFCyormu\u015F gibi yap\u0131yorsun."
    backgroundId: 
    nextNodeId: node_051
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_051
    type: 0
    speaker: 
    text: "Bir s\xFCre oturuyorsunuz. Deniz, g\xFCne\u015F, r\xFCzgar. Ve hi\xE7
      zorlanmayan bir sessizlik."
    backgroundId: 
    nextNodeId: node_052
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_052
    type: 1
    speaker: Jennifer
    text: "Bu kasabada ak\u015Fam yemek yenecek tek yer var. Bal\u0131k\xE7\u0131."
    backgroundId: 
    nextNodeId: node_053
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_053
    type: 0
    speaker: 
    text: "S\xF6yl\xFCyor. Sana bakmadan s\xF6yl\xFCyor. Davet de\u011Fil \u2014
      bir bilgi."
    backgroundId: 
    nextNodeId: node_054
    choices: []
    requiredFlag: 
    altNodeId: 
  - id: node_054
    type: 2
    speaker: 
    text: 
    backgroundId: 
    nextNodeId: 
    choices:
    - text: "Saat ka\xE7ta a\xE7\u0131yor?"
      nextNodeId: node_055
      effect:
        affection: 5
        setFlag: 
      isDiamond: 0
      diamondCost: 0
    - text: "Yaln\u0131z m\u0131 gidiyorsun?"
      nextNodeId: node_056
      effect:
        affection: 5
        setFlag: 
